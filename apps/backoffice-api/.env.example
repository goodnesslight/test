NODE_ENV=development

HOST=localhost
PORT=3100

CLIENT_URL=http://localhost:4300
# Leave empty for a host-only cookie (recommended in dev — the client proxies
# /api same-origin). Set to a parent domain only if you need one session shared
# across subdomains.
COOKIE_DOMAIN=

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# The backoffice shares the main platform database (organizations live there);
# it owns only its own tables (admins) via a separate migrations history.
POSTGRES_DB=platform
POSTGRES_USER=postgres
POSTGRES_PASSWORD=newpass
POSTGRES_SYNCHRONIZE=false

AUTH_ACCESS_TOKEN_SECRET=backoffice-access
AUTH_ACCESS_TOKEN_EXPIRATION=900
AUTH_REFRESH_TOKEN_SECRET=backoffice-refresh
AUTH_REFRESH_TOKEN_EXPIRATION=604800
