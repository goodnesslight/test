NODE_ENV=development

HOST=localhost
PORT=3000

CLIENT_URL=http://localhost:4200
# Leave empty for a host-only cookie (recommended in dev — the client proxies
# /api same-origin). Set to a parent domain (e.g. .example.com) only if you need
# one session shared across org subdomains.
COOKIE_DOMAIN=

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=platform
POSTGRES_USER=postgres
POSTGRES_PASSWORD=newpass
POSTGRES_SYNCHRONIZE=false

REDIS_HOST=localhost
REDIS_PORT=6379

STEAM_API_KEY=

# BunnyCDN: upload to the Storage Zone, serve via the pull-zone CDN hostname.
# BUNNY_STORAGE_ZONE is the Storage Zone name; BUNNY_STORAGE_HOST is its region
# endpoint (storage.bunnycdn.com = EU; ny./la./sg./syd. for others).
BUNNY_STORAGE_HOST=storage.bunnycdn.com
BUNNY_STORAGE_ZONE=
BUNNY_STORAGE_KEY=
BUNNY_CDN_URL=

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="Platform <no-reply@localhost>"

AUTH_ACCESS_TOKEN_SECRET=sponge-bob-access
AUTH_ACCESS_TOKEN_EXPIRATION=900
AUTH_REFRESH_TOKEN_SECRET=sponge-bob-refresh
AUTH_REFRESH_TOKEN_EXPIRATION=604800