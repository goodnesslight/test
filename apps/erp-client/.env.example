# Relative — the dev server proxies /api to the backend (see nitro.devProxy),
# so requests stay same-origin with the page and the auth cookie is sent.
API_URL=/api
BASE_DOMAIN=localhost:4200

# Bind to IPv4 so *.localhost subdomains (which resolve to 127.0.0.1) are
# reachable, and serve on 4200 to match CLIENT_URL / BASE_DOMAIN (3000 is the API).
NITRO_HOST=0.0.0.0
NITRO_PORT=4200
