{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "dist",
    "jsx": "preserve",
    "module": "esnext",
    "jsxImportSource": "vue",
    "moduleResolution": "bundler",
    "tsBuildInfoFile": "dist/tsconfig.app.tsbuildinfo",
    "noUnusedLocals": false,
    "resolveJsonModule": true,
    "lib": ["es2022", "dom", "dom.iterable"],
    "paths": {
      "#layers/*": ["./layers/*"]
    }
  },
  "references": [
    {
      "path": "../../libs/erp/dtos"
    },
    {
      "path": "../../libs/erp/types"
    },
    {
      "path": "../../libs/shared/types"
    },
    {
      "path": "../../libs/shared/utils"
    }
  ],
  "include": [
    ".nuxt/nuxt.d.ts",
    "app/**/*",
    "server/**/*",
    "layers/**/*",
    "layers/**/*.json"
  ],
  "exclude": [
    "out-tsc",
    "dist",
    "vite.config.ts",
    "vite.config.mts",
    "vitest.config.ts",
    "vitest.config.mts",
    "app/**/*.test.ts",
    "app/**/*.spec.ts",
    "app/**/*.test.tsx",
    "app/**/*.spec.tsx",
    "app/**/*.test.js",
    "app/**/*.spec.js",
    "app/**/*.test.jsx",
    "app/**/*.spec.jsx",
    "server/**/*.test.ts",
    "server/**/*.spec.ts",
    "server/**/*.test.tsx",
    "server/**/*.spec.tsx",
    "server/**/*.test.js",
    "server/**/*.spec.js",
    "server/**/*.test.jsx",
    "server/**/*.spec.jsx",
    "eslint.config.js",
    "eslint.config.cjs",
    "eslint.config.mjs"
  ]
}
